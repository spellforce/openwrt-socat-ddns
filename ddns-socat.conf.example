# ========================================
# DDNS & Socat 配置文件示例
# ========================================
# 
# 使用说明：
# 1. 复制此文件到 /etc/ddns-socat.conf
# 2. 根据实际情况修改配置项
# 3. 运行 ddns-socat-manager start 启动服务
#

# ========================================
# DDNS 配置
# ========================================

# 是否启用 DDNS 功能
# 可选值: true, false
DDNS_ENABLE="true"

# DDNS 提供商
# 当前支持: dnspod
# 未来计划支持: aliyun, cloudflare, huaweicloud
DDNS_PROVIDER="dnspod"

# DNSPod ID
# 获取方式: 登录 DNSPod 控制台 -> 用户中心 -> 安全设置 -> API Token
DDNS_ID="your_dnspod_id"

# DNSPod Token
# 获取方式: 同上
DDNS_TOKEN="your_dnspod_token"

# 主域名
# 示例: example.com
DDNS_DOMAIN="example.com"

# 子域名
# @ 表示根域名 (example.com)
# www 表示 www.example.com
# * 表示泛域名 (*.example.com)
DDNS_SUBDOMAIN="@"

# IP 检查间隔（秒）
# 建议值: 300-600 (5-10 分钟)
# 过于频繁可能被 API 限流
DDNS_INTERVAL="300"

# ========================================
# IPv6 配置
# ========================================

# IPv6 网络接口名称
# 常见值:
#   - pppoe-wan (PPPoE 拨号)
#   - pppoe-pppoe (部分固件)
#   - eth0.2 (静态 IPv6)
#   - wan6 (IPv6 WAN)
# 
# 查找方法: ip -6 addr show
IPV6_INTERFACE="pppoe-wan"

# IPv6 地址前缀（用于筛选地址）
# 常见运营商前缀:
#   - 电信: 240e
#   - 移动: 2409
#   - 联通: 2408
#   - 其他: 2001, 2400, 2402, 2403, 2404, 2405, 2406, 2407
IPV6_PREFIX="2409"

# ========================================
# Socat 端口转发配置
# ========================================

# 是否启用端口转发功能
SOCAT_ENABLE="true"

# 转发规则
# 格式：外部端口:内网IP:内网端口:描述
# 
# 注意事项：
# 1. 每行一条规则
# 2. 空行会被忽略
# 3. 描述中不要使用空格和特殊字符
# 4. 外部端口不能重复
# 5. 确保内网服务已启动
#
# 示例规则：

FORWARDS="
# SSH 服务器
22:192.168.1.100:22:SSH-Server

# Web 服务器
80:192.168.1.100:80:HTTP-Server
443:192.168.1.100:443:HTTPS-Server

# 群晖 NAS (Synology DSM)
5000:192.168.1.101:5000:DSM-HTTP
5001:192.168.1.101:5001:DSM-HTTPS

# 远程桌面 (Windows RDP)
3389:192.168.1.200:3389:Windows-RDP

# VNC 远程桌面
5900:192.168.1.200:5900:VNC-Server

# 自定义服务
8080:192.168.1.102:8080:Custom-Service
9090:192.168.1.103:9090:Another-Service
"

# ========================================
# 防火墙配置
# ========================================

# 是否自动管理防火墙规则
# true: 自动添加/删除规则
# false: 需要手动管理防火墙
FIREWALL_ENABLE="true"

# 防火墙区域
# 通常使用 wan
FIREWALL_ZONE="wan"

# ========================================
# 监控配置
# ========================================

# 是否启用 IP 变化监控
# true: 启动后台守护进程，自动检测 IPv6 变化
# false: 禁用监控，需手动更新
MONITOR_ENABLE="true"

# IP 变化时是否记录详细日志
# true: 记录 IP 变化详情
# false: 仅记录简单日志
MONITOR_LOG_CHANGES="true"

# ========================================
# 常见配置场景
# ========================================

# 场景 1: 群晖 NAS 外网访问
# FORWARDS="
# 5000:192.168.1.101:5000:DSM-HTTP
# 5001:192.168.1.101:5001:DSM-HTTPS
# 22:192.168.1.101:22:SSH
# "

# 场景 2: Web 服务器
# FORWARDS="
# 80:192.168.1.100:80:HTTP
# 443:192.168.1.100:443:HTTPS
# 22:192.168.1.100:22:SSH
# "

# 场景 3: 远程桌面
# FORWARDS="
# 3389:192.168.1.200:3389:Windows-RDP
# 5900:192.168.1.200:5900:VNC
# "

# 场景 4: 开发环境
# FORWARDS="
# 3000:192.168.1.150:3000:React-Dev
# 8080:192.168.1.150:8080:API-Server
# 5432:192.168.1.150:5432:PostgreSQL
# 27017:192.168.1.150:27017:MongoDB
# "

# 场景 5: 多服务混合
# FORWARDS="
# 22:192.168.1.100:22:Router-SSH
# 80:192.168.1.101:80:Web-Server
# 443:192.168.1.101:443:HTTPS-Server
# 5000:192.168.1.102:5000:NAS-HTTP
# 5001:192.168.1.102:5001:NAS-HTTPS
# 3389:192.168.1.103:3389:Desktop-RDP
# "

